{
  "manifest_version": 3,
  "name": "Hoos Spelling Word Importer",
  "version": "1.0.0",
  "description": "Import the visible SB Solver word list into Hoos Spelling.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.sbsolver.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
